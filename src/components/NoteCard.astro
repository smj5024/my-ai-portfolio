---
import type { CollectionEntry } from 'astro:content';
import { formatDate, withBase } from '../lib/site';
import StatusBadge from './StatusBadge.astro';

interface Props {
  note: CollectionEntry<'notes'>;
  compact?: boolean;
}

const { note, compact = false } = Astro.props;
---

<article class:list={['note-card', { compact }]} data-pagefind-ignore>
  <div class="note-meta">
    <StatusBadge status={note.data.status} />
    <time datetime={note.data.published.toISOString()}>{formatDate(note.data.published)}</time>
  </div>
  <h3><a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a></h3>
  <p>{note.data.summary}</p>
  <div class="tag-row">
    {note.data.tags.slice(0, compact ? 2 : 4).map((tag) => <span>{tag}</span>)}
  </div>
</article>
