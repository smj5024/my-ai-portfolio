---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout title="页面未找到" description="请求的页面不存在。" noindex={true}>
  <section class="not-found shell">
    <p class="error-code">ERROR / 404</p>
    <div class="error-display">04<span></span>04</div>
    <h1>这条实验路径还没有建立</h1>
    <p>链接可能已经移动，或者内容仍处于未公开状态。</p>
    <div class="hero-actions">
      <a class="button button-primary" href={withBase('/')}>返回首页</a>
      <a class="button button-ghost" href={withBase('/search/')}>搜索站点</a>
    </div>
  </section>
</BaseLayout>
