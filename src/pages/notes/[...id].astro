---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { formatDate, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

interface Props { note: CollectionEntry<'notes'> }
const { note } = Astro.props;
const { Content, headings } = await render(note);
---

<BaseLayout title={note.data.title} description={note.data.summary}>
  <article class="article-shell shell">
    <header class="article-header">
      <a class="breadcrumb" href={withBase('/notes/')}>← 返回知识笔记</a>
      <div class="article-status"><StatusBadge status={note.data.status} /><span>{note.data.stage}</span></div>
      <h1>{note.data.title}</h1>
      <p>{note.data.summary}</p>
      <div class="article-byline">
        <span>发布于 <time datetime={note.data.published.toISOString()}>{formatDate(note.data.published)}</time></span>
        {note.data.updated && <span>更新于 {formatDate(note.data.updated)}</span>}
        <span>SMJ / EdgeMind Lab</span>
      </div>
    </header>
    <div class="article-layout">
      <div class="prose"><Content /></div>
      <aside class="article-aside">
        <div class="aside-block"><strong>主题标签</strong><div class="tag-row">{note.data.tags.map((tag) => <span>{tag}</span>)}</div></div>
        {headings.length > 0 && <div class="aside-block toc"><strong>本页目录</strong>{headings.filter((h) => h.depth <= 3).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</div>}
        <div class="aside-note">学习笔记会持续修订。状态不等于结论，实验数据以对应档案为准。</div>
      </aside>
    </div>
  </article>
</BaseLayout>
